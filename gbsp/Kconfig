config GBSP
	bool "gpSP Game Boy Advance emulator core with a RISC-V dynamic recompiler"
	depends on RISCV
	select FILE_SYSTEM
	help
	  Build the gpSP core (core/) as a library. It translates the ARM code
	  of the game to RISC-V when CONFIG_GBSP_DYNAREC is on, and interprets it
	  otherwise. The built-in open source BIOS is used, no BIOS file is
	  needed. The interface is the one of the mGBA module (gbsp_zephyr/gbsp.h, the functions are called gbsp_*).

if GBSP

config GBSP_DYNAREC
	bool "Dynamic recompiler (translates the ARM code to RISC-V)"
	default y
	help
	  Without it the core interprets the game code, which is much slower.
	  The translated code is kept in two caches that are allocated when a
	  game starts.

config GBSP_ROM_CACHE_KB
	int "Translation cache for the ROM code (KiB)"
	depends on GBSP_DYNAREC
	default 2048
	help
	  When it is full all of it is emptied and the code is translated again. A scene whose
	  code does not fit translates about a thousand blocks per frame, which is more than ten
	  times the normal cost of a frame (Kirby has such a scene with 1 MiB, none with 2 MiB).

config GBSP_ROM_PREFETCH
	bool "Read the ROM ahead in a background thread (large ROMs only)"
	select FS_FATFS_REENTRANT
	help
	  Measured on Kirby (16 MiB ROM, 5 MiB resident): few of the page misses are sequential,
	  so few hit the staging buffer, and the speculative reads compete with the demanded ones
	  for the card: the worst frame went from 50 ms to 119 ms. Off by default.

config GBSP_ROM_READAHEAD
	int "Pages of the ROM read with one card access, and fetched ahead"
	default 4
	range 1 8
	help
	  A page of a ROM that does not fit in memory is read from the card when the game needs
	  it (32 KiB, about 2 ms). On a miss this many consecutive pages are read at once, and the
	  same number after them by a background thread, so that the next misses find their page
	  in a staging buffer.

config GBSP_ROM_STAGE_PAGES
	int "Staging buffers of the read-ahead (32 KiB each, from the malloc arena while a game runs)"
	default 8
	range 4 32

config GBSP_ROM_PREFETCH_PRIORITY
	int "Priority of the read-ahead thread (lower is more urgent)"
	default 11
	help
	  Below the emulation and the user interface: it reads while they wait.

config GBSP_RAM_CACHE_KB
	int "Translation cache for the code that runs from RAM (KiB)"
	depends on GBSP_DYNAREC
	default 256

config GBSP_RVV
	bool "Vector version of the tile renderer (needs the V extension)"
	default y if SUN252I_F101_RVV
	help
	  The rows of 4 bit tiles that are drawn as colour indices are expanded on the vector unit.
	  The application must switch CONFIG_SUN252I_F101_RVV on (vector registers are saved on a
	  context switch).

config GBSP_OPT_LEVEL
	string "Optimisation level of the core (-O3, -O2, -Os)"
	default "-O3"

config GBSP_MAX_ROM_SIZE_MB
	int "Largest ROM (MiB)"
	default 32
	range 1 32
	help
	  Blocks of the ROM are kept in memory as far as the memory goes; the
	  rest is read from the file when the game needs it.

config GBSP_ROM_BUFFER_MB
	int "Memory for the ROM (MiB)"
	default 6
	range 1 32
	help
	  The ROM is kept in memory as far as this goes; the pages of a larger ROM are read from
	  the file when the game needs them.

endif # GBSP
