mainmenu "iOS screen mirror"

config SAMPLE_IOS_WIFI_SSID
	string "SSID to start with"
	default ""
	help
	  Used while /SD:/wifi.cfg does not exist (the Android mirror player writes that file:
	  the name on the first line, the password on the second).

config SAMPLE_IOS_WIFI_PSK
	string "WPA2 passphrase to start with"
	default ""

config SAMPLE_IOS_HOLD_FRAMES
	int "Pictures the decoder keeps besides its two working ones"
	default 4
	help
	  Every picture takes memory (650 KB for the portrait stream of the phone, 448x972), but
	  with fewer the decoder runs out of pictures to decode into and stops: 2 deadlocks.

source "Kconfig.zephyr"
