# Toolchain file of the litehtml sub build, generated by litehtml/CMakeLists.txt
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)
set(CMAKE_C_COMPILER @LH_CC@)
set(CMAKE_CXX_COMPILER @LH_CXX@)
set(CMAKE_AR @LH_AR@)
set(CMAKE_RANLIB @LH_RANLIB@)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)

# The toolchain's own newlib and libstdc++ headers, same architecture options as the
# image. Nothing of the library is linked against newlib: the final link uses the
# C library of the image and only the header-only parts of libstdc++ (the standard
# streams are replaced by forward declarations, see ext/shim).
set(_lh_flags "@LH_ARCH_FLAGS@ -ffunction-sections -fdata-sections -fno-pic -fno-asynchronous-unwind-tables")
set(CMAKE_C_FLAGS_INIT "${_lh_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_lh_flags} -fno-exceptions -D_GLIBCXX_EXTERN_TEMPLATE=0")
