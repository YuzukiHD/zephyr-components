# The options of the port itself are the MICROPY_* ones of
# micropython/ports/zephyr/Kconfig.

config F101_MICROPY_SCREEN_CONSOLE
	bool "Show the console output on the LCD"
	default y
	depends on DISPLAY
	select CHARACTER_FRAMEBUFFER
	help
	  Everything MicroPython prints is also drawn into a character grid on the
	  frame buffer plane. The UART stays the keyboard.
