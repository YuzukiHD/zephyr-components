/*
 * MP5 runs in place from the flash: the image is linked into the memory window of the SPIF
 * controller, which the boot stub (SyterKit xip-boot) maps from the flash offset 0x8000 at
 * 0x0e000000. The window is 6 MiB, up to the end of the 16 MiB flash.
 */

/*
 * The SoC description keeps the first 64 KiB of the PSRAM free for a boot loader that hands a
 * configuration block over. This image starts from the flash and nobody writes there: the memory
 * is RAM like the rest.
 */
&sram0 {
	reg = <0x40000000 0x1000000>;
};

/ {
	soc {
		xip_flash: flash@e000000 {
			compatible = "soc-nv-flash";
			reg = <0x0e000000 0x600000>;
			erase-block-size = <4096>;
			write-block-size = <1>;
		};
	};

	chosen {
		zephyr,flash = &xip_flash;
	};

	/* LVGL reads the GT967 touch panel as a pointer */
	lvgl_pointer {
		compatible = "zephyr,lvgl-pointer-input";
		input = <&touch>;
	};
};

/* spi0 uses the pins of the flash (PC0..PC5): switching them away would cut the window off */
&spi0 {
	status = "disabled";
};

/* the panel is brought up by the application in a thread of its own, in parallel with the rest of the start */
&display {
	zephyr,deferred-init;
};
