config MP5_FEATURE_USB_DISPLAY
	bool "USB second screen with touch"
	default y
	select VDEC
	select CHERRYUSB
	select CHERRYUSB_DEVICE
	select CHERRYUSB_DEVICE_DISPLAY
	select CHERRYUSB_DEVICE_HID

choice CHERRYUSB_DEVICE_SPEED
	default CHERRYUSB_DEVICE_SPEED_HS if MP5_FEATURE_USB_DISPLAY
endchoice

choice CHERRYUSB_DEVICE_IP
	default CHERRYUSB_DEVICE_MUSB_SUNXI if MP5_FEATURE_USB_DISPLAY
endchoice
