config NCNN
	bool "ncnn neural network inference framework"
	depends on CPP && RISCV
	help
	  Build ncnn (the ncnn submodule) as a separate static library with its
	  own STL and math emulation, on top of the minimal C library. The
	  library is compiled with the architecture options of the image, so
	  with the V extension (RISCV_ISA_EXT_V) the vector kernels of ncnn
	  are used.

if NCNN

config NCNN_BENCHMARK
	bool "ncnn benchmark (benchncnn)"
	default y
	help
	  Build the benchncnn program as ncnn_bench_main(argc, argv), with the
	  network descriptions built in and random weights.

config NCNN_BENCHMARK_MODELS
	string "Networks to run"
	depends on NCNN_BENCHMARK
	help
	  Comma separated names of the networks benchncnn runs, empty: all of
	  them. The int8 networks are never run, ncnn is built without int8.
	  The networks run from the smallest to the biggest. One during which
	  an allocation fails is not reported.

config NCNN_BENCHMARK_MAX_WEIGHTS_MB
	int "Biggest network to try (MB of fp32 weights)"
	depends on NCNN_BENCHMARK
	default 5
	help
	  Networks with more weights than this are not run at all (0: no
	  limit). The weights are in RAM and the layers make a second copy of
	  them while they are set up, with 13 MB of heap on a 16 MB board only
	  the small networks fit. ncnn does not check the allocation of the
	  weights and crashes when they do not fit, so the big networks (some
	  have hundreds of MB of weights) must not be tried.

endif # NCNN
