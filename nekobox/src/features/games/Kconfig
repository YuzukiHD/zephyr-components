menu "Games"

config NEKOBOX_FEATURE_GAMES
	bool "NES, Game Boy, Game Boy Color (mGBA) and Game Boy Advance (gpSP)"
	default y
	depends on NEKOBOX_FEATURE_FILES
	select MGBA
	select GBSP
	select NES
	select CRC
	select RING_BUFFER
	select STATIC_INIT_GNU
	select I2S
	select AUDIO
	select AUDIO_CODEC
	select DMA

config NEKOBOX_GAMES_HOT_RAM
	bool "Run the Game Boy Advance core from RAM"
	default y
	depends on XIP && NEKOBOX_FEATURE_GAMES
	select CODE_DATA_RELOCATION
	help
	  In an XIP image every instruction that is not in the cache comes from the flash window.
	  The renderer and the memory handlers of the GBA core (gpSP) run for every frame, so they
	  are copied to RAM at boot. The translated game code is in RAM anyway. The Game Boy core
	  (mGBA) stays in the flash window.

config NEKOBOX_GAME
	string "Game to start at boot, for a check without touching (empty: none)"
	default ""
	depends on NEKOBOX_FEATURE_GAMES

endmenu
