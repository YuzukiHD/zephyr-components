menu "Settings"

config NEKOBOX_FEATURE_SETTINGS
	bool "Settings screen"
	default y

config NEKOBOX_FEATURE_BRIGHTNESS
	bool "Brightness row"
	default y
	depends on NEKOBOX_FEATURE_SETTINGS

config NEKOBOX_FEATURE_THEME_PICKER
	bool "Dark or light and accent colour rows"
	default y
	depends on NEKOBOX_FEATURE_SETTINGS

endmenu
