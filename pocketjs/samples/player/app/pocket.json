{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.yuzuki.f101-player",
  "name": "f101-player",
  "title": "PocketJS F101",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.buttons", "text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "main.tsx",
    "output": "f101-player",
    "framework": "solid",
    "viewport": {
      "logical": [320, 240],
      "presentation": "native"
    }
  }
}
