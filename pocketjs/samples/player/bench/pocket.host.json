{
  "$schema": "https://pocketjs.dev/schema/pocket-idf-host-1.json",
  "version": 1,
  "id": "f101-bench",
  "platform": "esp-idf",
  "form": "takeover",
  "tickHz": 60,
  "display": {
    "physicalViewport": [512, 384],
    "logicalViewports": [[512, 384]],
    "presentations": ["native"],
    "rasterDensity": 1
  },
  "capabilities": ["input.buttons", "input.touch", "text.glyphs.baked"]
}
