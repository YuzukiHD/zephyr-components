# Toolchain file of the ncnn sub build, generated by lib/ncnn/CMakeLists.txt
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)
set(CMAKE_C_COMPILER @NCNN_CC@)
set(CMAKE_CXX_COMPILER @NCNN_CXX@)
set(CMAKE_AR @NCNN_AR@)
set(CMAKE_RANLIB @NCNN_RANLIB@)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)

# Same architecture options as the image. The headers are those of the
# minimal C library plus lib/ncnn/shim, which declares what ncnn needs on top
# of it. The types are the ones of the compiler (the vector builtins take them).
set(_ncnn_flags "@NCNN_ARCH_FLAGS@ -ffreestanding -nostdinc -include @NCNN_SHIM_DIR@/ncnn_libc.h -isystem @NCNN_SHIM_DIR@ -isystem @ZEPHYR_BASE@/lib/libc/minimal/include -isystem @ZEPHYR_BASE@/lib/libc/common/include -isystem @NCNN_GCC_INCLUDE@ -I@ZEPHYR_BASE@/include@NCNN_ZEPHYR_INCLUDES@ -I@NCNN_ZEPHYR_GENERATED@ -imacros @NCNN_ZEPHYR_GENERATED@/zephyr/autoconf.h -fno-pic -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections")
set(CMAKE_C_FLAGS_INIT "${_ncnn_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_ncnn_flags} -nostdinc++ -fpermissive -fno-exceptions -fno-rtti")
